---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TutorialFeedbackForm from '../../components/TutorialFeedbackForm.astro';
import { SITE_TITLE } from '../../consts';
import { url } from '../../utils/paths';

export async function getStaticPaths() {
	const tutorials = await getCollection('tutorials');
	return tutorials.map((tutorial) => ({
		params: { slug: tutorial.id },
		props: tutorial,
	}));
}

type Props = CollectionEntry<'tutorials'>;

const tutorial = Astro.props;
const { Content } = await render(tutorial);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${tutorial.data.title} | Tutorials | ${SITE_TITLE}`}
			description={tutorial.data.description}
		/>
	</head>
	<body>
		<Header />
		<main>
			<a class="back" href={url('/tutorials')}>
				<span aria-hidden="true">←</span> All tutorials
			</a>

			<article class="article">
				<header class="article-head" data-reveal>
					<div class="meta-line">
						<span>{tutorial.data.category}</span>
						<span class="dot">·</span>
						<span>{tutorial.data.status}</span>
						{tutorial.data.duration && (
							<>
								<span class="dot">·</span>
								<span>{tutorial.data.duration}</span>
							</>
						)}
					</div>

					<h1>{tutorial.data.title}</h1>
					<p class="lede">{tutorial.data.description}</p>
				</header>

				<section class="video-section" data-reveal style="--reveal-delay: 80ms;">
					<div class="video-frame">
						{tutorial.data.videoUrl ? (
							<iframe
								src={tutorial.data.videoUrl}
								title={tutorial.data.title}
								loading="lazy"
								allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
								allowfullscreen
							></iframe>
						) : (
							<div class="video-placeholder">
								<span class="placeholder-label">{tutorial.data.status}</span>
								<div class="placeholder-center">
									<span class="play-mark" aria-hidden="true">▶</span>
									<p>Video placeholder</p>
								</div>
							</div>
						)}
					</div>

					<div class="supporting">
						{tutorial.data.learn && tutorial.data.learn.length > 0 && (
							<section class="support-block">
								<h2>What you'll learn</h2>
								<ul>
									{tutorial.data.learn.map((item) => <li>{item}</li>)}
								</ul>
							</section>
						)}

						{tutorial.data.recommendedNext && tutorial.data.recommendedNext.length > 0 && (
							<section class="support-block">
								<h2>Recommended next</h2>
								<ul class="link-list">
									{tutorial.data.recommendedNext.map((item) => (
										<li><a href={url(item.href)}>{item.title}</a></li>
									))}
								</ul>
							</section>
						)}

						{tutorial.data.notes && tutorial.data.notes.length > 0 && (
							<section class="support-block">
								<h2>Notes</h2>
								<ul class="link-list">
									{tutorial.data.notes.map((item) => (
										<li><a href={url(item.href)}>{item.label}</a></li>
									))}
								</ul>
							</section>
						)}
					</div>
				</section>

				<div class="article-body" data-reveal style="--reveal-delay: 120ms;">
					<Content />
				</div>

				<TutorialFeedbackForm
					tutorialSlug={tutorial.id}
					tutorialTitle={tutorial.data.title}
					tutorialCategory={tutorial.data.category}
				/>
			</article>
		</main>
		<Footer />

		<style>
			.back {
				display: inline-block;
				font-size: 0.88rem;
				color: var(--color-text-muted);
				border: none;
				margin: 1rem 0 2rem;
			}
			.back:hover { color: var(--color-accent); border: none; }
			.back span { color: var(--color-accent); margin-right: 0.4rem; }

			.article-head {
				padding-bottom: 2rem;
				border-bottom: 1px solid var(--color-border);
				margin-bottom: 2rem;
				max-width: 66ch;
			}
			.meta-line {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				font-family: var(--font-mono);
				font-size: 0.78rem;
				color: var(--color-text-faint);
				margin-bottom: 1rem;
			}
			.dot { color: var(--color-text-faint); }
			h1 {
				margin: 0 0 0.9rem;
			}
			.lede {
				font-size: 1.1rem;
				line-height: 1.65;
				color: var(--color-text-muted);
				margin: 0;
				max-width: 58ch;
			}

			.video-section {
				display: grid;
				grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
				gap: 2rem;
				align-items: start;
				margin-bottom: 3rem;
			}
			.video-frame {
				aspect-ratio: 16 / 9;
				border: 1px solid var(--color-border);
				border-radius: 18px;
				overflow: hidden;
				background: linear-gradient(180deg, var(--color-bg-subtle), var(--color-bg));
			}
			.video-frame iframe,
			.video-placeholder {
				width: 100%;
				height: 100%;
				border: 0;
			}
			.video-placeholder {
				padding: 1.2rem;
				display: flex;
				flex-direction: column;
			}
			.placeholder-label {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--color-text-faint);
			}
			.placeholder-center {
				flex: 1;
				display: grid;
				place-items: center;
				text-align: center;
				color: var(--color-text-muted);
			}
			.play-mark {
				font-size: 1.8rem;
				color: var(--color-accent);
			}
			.placeholder-center p {
				margin: 0.5rem 0 0;
			}

			.supporting {
				display: grid;
				gap: 1.25rem;
			}
			.support-block {
				border-top: 1px solid var(--color-border);
				padding-top: 0.9rem;
			}
			.support-block h2 {
				font-size: 0.95rem;
				margin: 0 0 0.75rem;
			}
			.support-block ul {
				margin: 0;
				padding-left: 1.2rem;
			}
			.support-block li {
				margin-bottom: 0.45rem;
				color: var(--color-text-main);
				line-height: 1.55;
			}
			.link-list a {
				color: var(--color-text-main);
			}

			.article-body {
				max-width: 66ch;
				font-size: 1.02rem;
				line-height: 1.7;
			}
			.article-body :global(p) {
				color: var(--color-text-main);
				margin-bottom: 1.1rem;
			}

			@media (max-width: 900px) {
				.video-section {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</body>
</html>
