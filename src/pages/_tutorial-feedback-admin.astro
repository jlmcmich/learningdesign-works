---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Tutorial Feedback Admin | ${SITE_TITLE}`}
			description="Private review page for tutorial feedback submissions."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-head" data-reveal>
				<h1>Tutorial Feedback</h1>
				<p class="page-lede">
					Private review page for recent questions, suggestions, and topic requests from tutorial viewers.
				</p>
			</section>

			<section class="auth-panel" data-reveal style="--reveal-delay: 60ms;">
				<form id="admin-form" class="admin-form">
					<label>
						<span>Admin token</span>
						<input
							id="token-input"
							name="token"
							type="password"
							autocomplete="off"
							placeholder="Paste your feedback admin token"
							required
						/>
					</label>
					<div class="admin-actions">
						<button type="submit" class="btn">Load feedback</button>
						<button type="button" class="btn btn-outline" id="clear-token">Clear saved token</button>
					</div>
					<p id="admin-status" class="admin-status" aria-live="polite"></p>
				</form>
			</section>

			<section class="results" data-reveal style="--reveal-delay: 120ms;">
				<div class="results-head">
					<h2>Recent submissions</h2>
					<p id="submission-count" class="submission-count">No submissions loaded yet.</p>
				</div>

				<div class="table-wrap">
					<table class="submissions-table">
						<thead>
							<tr>
								<th>When</th>
								<th>Tutorial</th>
								<th>Type</th>
								<th>From</th>
								<th>Message</th>
							</tr>
						</thead>
						<tbody id="submissions-body">
							<tr>
								<td colspan="5" class="empty-state">Load your token to view recent submissions.</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const storageKey = 'tutorial-feedback-admin-token';
			const form = document.getElementById('admin-form');
			const tokenInput = document.getElementById('token-input');
			const clearButton = document.getElementById('clear-token');
			const status = document.getElementById('admin-status');
			const tbody = document.getElementById('submissions-body');
			const count = document.getElementById('submission-count');

			const escapeHtml = (value) =>
				String(value ?? '')
					.replaceAll('&', '&amp;')
					.replaceAll('<', '&lt;')
					.replaceAll('>', '&gt;')
					.replaceAll('"', '&quot;')
					.replaceAll("'", '&#39;');

			const formatDate = (value) => {
				if (!value) return '';
				const date = new Date(value);
				if (Number.isNaN(date.getTime())) return value;
				return date.toLocaleString('en-US', {
					year: 'numeric',
					month: 'short',
					day: 'numeric',
					hour: 'numeric',
					minute: '2-digit',
				});
			};

			const renderRows = (rows) => {
				if (!tbody || !count) return;
				if (!rows.length) {
					tbody.innerHTML =
						'<tr><td colspan="5" class="empty-state">No submissions yet.</td></tr>';
					count.textContent = '0 submissions loaded.';
					return;
				}

				tbody.innerHTML = rows
					.map((row) => {
						const fromParts = [row.name, row.email].filter(Boolean).map(escapeHtml);
						const from = fromParts.length ? fromParts.join('<br />') : '<span class="muted">Anonymous</span>';
						const tutorial = `
							<div class="tutorial-cell">
								<strong>${escapeHtml(row.tutorial_title)}</strong>
								<span>${escapeHtml(row.tutorial_category || '')}</span>
							</div>
						`;
						return `
							<tr>
								<td class="when-cell">${escapeHtml(formatDate(row.created_at))}</td>
								<td>${tutorial}</td>
								<td class="type-cell">${escapeHtml(row.feedback_type || '')}</td>
								<td>${from}</td>
								<td class="message-cell">${escapeHtml(row.message || '')}</td>
							</tr>
						`;
					})
					.join('');
				count.textContent = `${rows.length} submission${rows.length === 1 ? '' : 's'} loaded.`;
			};

			const loadFeedback = async (token) => {
				if (!status) return;
				status.textContent = 'Loading feedback...';

				try {
					const response = await fetch(`/api/tutorial-feedback?token=${encodeURIComponent(token)}`, {
						headers: { Accept: 'application/json' },
					});
					const result = await response.json().catch(() => ({}));
					if (!response.ok) {
						throw new Error(result?.error || 'Unable to load feedback.');
					}

					localStorage.setItem(storageKey, token);
					renderRows(result.submissions || []);
					status.textContent = 'Feedback loaded.';
				} catch (error) {
					renderRows([]);
					status.textContent =
						error instanceof Error ? error.message : 'Unable to load feedback.';
				}
			};

			form?.addEventListener('submit', (event) => {
				event.preventDefault();
				if (!(tokenInput instanceof HTMLInputElement)) return;
				const token = tokenInput.value.trim();
				if (!token) return;
				loadFeedback(token);
			});

			clearButton?.addEventListener('click', () => {
				localStorage.removeItem(storageKey);
				if (tokenInput instanceof HTMLInputElement) tokenInput.value = '';
				renderRows([]);
				if (status) status.textContent = 'Saved token cleared.';
				if (count) count.textContent = 'No submissions loaded yet.';
			});

			const savedToken = localStorage.getItem(storageKey);
			if (savedToken && tokenInput instanceof HTMLInputElement) {
				tokenInput.value = savedToken;
				loadFeedback(savedToken);
			}
		</script>

		<style>
			.page-head {
				padding: 2.5rem 0 2rem;
				border-bottom: 1px solid var(--color-border);
				margin-bottom: 1.75rem;
				max-width: 68ch;
			}
			.page-head h1 {
				margin: 0 0 0.85rem;
			}
			.page-lede {
				margin: 0;
				color: var(--color-text-muted);
				font-size: 1.02rem;
				line-height: 1.65;
			}

			.auth-panel {
				margin-bottom: 2rem;
				max-width: 56ch;
			}
			.admin-form {
				display: grid;
				gap: 0.9rem;
			}
			.admin-form label {
				display: grid;
				gap: 0.45rem;
			}
			.admin-form span {
				font-size: 0.82rem;
				color: var(--color-text-muted);
			}
			.admin-form input {
				width: 100%;
				font: inherit;
				color: var(--color-text-main);
				background: var(--color-bg);
				border: 1px solid var(--color-border);
				border-radius: var(--radius);
				padding: 0.75rem 0.85rem;
			}
			.admin-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
			}
			.admin-status {
				margin: 0;
				font-size: 0.9rem;
				color: var(--color-text-muted);
			}

			.results-head {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1rem;
				margin-bottom: 1rem;
				padding-bottom: 0.75rem;
				border-bottom: 1px solid var(--color-border);
			}
			.results-head h2 {
				margin: 0;
				font-size: 1.05rem;
			}
			.submission-count {
				margin: 0;
				font-size: 0.84rem;
				color: var(--color-text-muted);
			}

			.table-wrap {
				overflow-x: auto;
				border: 1px solid var(--color-border);
				border-radius: 14px;
			}
			.submissions-table {
				width: 100%;
				border-collapse: collapse;
				background: var(--color-bg);
			}
			.submissions-table th,
			.submissions-table td {
				padding: 0.9rem 1rem;
				text-align: left;
				vertical-align: top;
				border-bottom: 1px solid var(--color-border-soft);
				font-size: 0.92rem;
				line-height: 1.5;
			}
			.submissions-table th {
				font-family: var(--font-mono);
				font-size: 0.74rem;
				font-weight: 500;
				color: var(--color-text-faint);
				background: var(--color-bg-subtle);
			}
			.submissions-table tr:last-child td {
				border-bottom: none;
			}
			.when-cell,
			.type-cell {
				white-space: nowrap;
				color: var(--color-text-muted);
			}
			.tutorial-cell {
				display: grid;
				gap: 0.2rem;
			}
			.tutorial-cell strong {
				font-size: 0.94rem;
			}
			.tutorial-cell span {
				font-size: 0.8rem;
				color: var(--color-text-muted);
			}
			.message-cell {
				min-width: 24rem;
				max-width: 38rem;
				white-space: pre-wrap;
			}
			.empty-state {
				text-align: center;
				color: var(--color-text-muted);
				padding: 1.5rem;
			}
			.muted {
				color: var(--color-text-muted);
			}

			@media (max-width: 760px) {
				.results-head {
					flex-direction: column;
					align-items: flex-start;
				}
			}
		</style>
	</body>
</html>
