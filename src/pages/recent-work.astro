---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LoopVideo from '../components/LoopVideo.astro';
import { SITE_TITLE, CONTACT_EMAIL } from '../consts';
import { url } from '../utils/paths';
import { getCollection } from 'astro:content';

const earlierAi = (await getCollection('projects'))
	.filter((p) => p.data.year >= 2023)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const approach = [
	{
		n: '1',
		title: 'Start with how people actually work',
		body: [
			"The best AI solutions sit inside the specific ways people do their jobs: their expertise, their tacit knowledge, and how their team thinks together. Teams that work well have grown systems that fit them. I watch that work from several perspectives to find the places where an agent could live.",
			"Then I start small and let it grow, more like a garden than a blueprint. People should discover what AI can do for them. When it is their own discovery, the change feels chosen instead of imposed.",
		],
		quote: {
			text: 'Becoming knowledgeably skillful and developing an identity in a field are part of the same process.',
			cite: 'after Jean Lave',
		},
	},
	{
		n: '2',
		title: 'Prototype on a real problem',
		body: [
			"A real problem gives the work stakes. Testing against reality shows where the tools are strong, where the frontier is, and where value actually gets created. It moves past the demo toward something minimal that is genuinely useful.",
			"Even when people don't adopt it yet, they now know what is possible, and that changes how they think about their work.",
		],
	},
	{
		n: '3',
		title: 'Build for the team, not one person',
		body: [
			"Agents today are mostly single-player. Everyone can get faster at their own tasks while the group gets no closer to its goal. Students finish assignments faster, instructors grade faster, administrators flag at-risk students sooner, and learning in the classroom doesn't improve.",
			"Bringing AI into a team means redesigning the environment to make a place for it. Otherwise AI feels like something that happens to people.",
		],
	},
];

type Engagement = {
	kind: string;
	title: string;
	body: string;
	link?: { href: string; label: string };
	links?: { href: string; label: string }[];
};

const engagements: Engagement[] = [
	{
		kind: 'Workshop',
		title: 'Hands-on Claude training for first-year medical students',
		body: "A three-day workshop and datathon for first-year students at ASU's new School of Medicine. These were the first ASU students on enterprise Claude. It led to a second student session and a session for faculty and staff.",
		link: { href: 'https://links.asu.edu/iweek-claude', label: 'See the workbook' },
	},
	{
		kind: 'Workshop',
		title: 'An executive committee retreat',
		body: "A two-hour build session at the retreat of the Office of the COO's executive committee. Leaders built working apps around tasks they actually do, and many are now looking for ways to put what they built into use.",
		link: { href: 'https://links.asu.edu/cec-ai-workbook', label: 'See the workbook' },
	},
	{
		kind: 'Advising',
		title: 'Strategic planning for a new school',
		body: "I serve on the School of Medicine's Strategic Planning Advisory Committee. I help its leadership work out where AI fits in the school's plan, and work with its teams to turn those priorities into training and tools.",
	},
	{
		kind: 'Workshop',
		title: 'Designing learning environments in an agentic world',
		body: "A pre-conference workshop at AAC&U's Conference on AI and Higher Education, built around the agentic LMS sandbox and co-designed with Michelle Kassorla.",
		links: [
			{ href: 'https://links.asu.edu/aacu-agents', label: 'See the workbook' },
			{ href: '/sandbox', label: 'See the sandbox' },
		],
	},
];

const primitives = [
	{
		name: 'Ready-made agent environments',
		body: 'Downloadable kits (folders, instructions, skills) that load straight into a person’s own agent, so it already has the context for the activity.',
	},
	{
		name: 'Starting prompts',
		body: 'They get people past the blank box, and give the room a shared experience to compare: where results were alike, where they differed.',
	},
	{
		name: 'The agent as teaching assistant',
		body: 'Instructions in the kit guide each person through the experience I designed. Afterward they open the files to see how it worked, which builds agentic literacy.',
	},
	{
		name: 'A workbook that stays with them',
		body: 'What I want people to read and take away lives on the page, not on another screen. It keeps their work, so they can pick up where they left off.',
	},
];

type Tool = {
	name: string;
	status?: string;
	summary: string;
	points: string[];
	video?: { dir: string; name: string; width: number; height: number; label: string };
	link?: { href: string; label: string };
};

const tools: Tool[] = [
	{
		name: 'Signal and Tracker',
		summary: "An information pipeline that keeps the team current on the AI tools ASU offers, so the university's AI tools page keeps up with a fast-moving field.",
		points: [
			'Signal monitors the sources where news about our tools shows up: support channels, the knowledge base, vendor release notes and the page itself. It suggests specific edits, with the evidence for each.',
			'Tracker is its complement. Accepted suggestions become tracked tasks, and the team makes the edits.',
			'The board is built for the team meeting, so we go through what we have learned together.',
		],
	},
	{
		name: 'Scribe',
		summary: "A meeting notetaker for the Mac that keeps recordings on the person's device and transcribes through ASU's own AI platform.",
		points: [
			"Many groups weren't recording meetings at all, because they didn't know where the audio went or whether it would be used for training. Our own team kept losing good ideas we had together. Scribe keeps sensitive meetings in ASU's hands. The goal is to run it on a local model on Sol, ASU's supercomputer, so ASU meetings stay on ASU hardware.",
			'An agent skill lets people bring their transcripts into project work, so their agents can work with them.',
			"Benchmarked against Zoom's own transcripts, which people were already using, it had about half as many errors. It also uses far less memory than a commercial notetaker, which matters across the range of devices people use.",
		],
	},
	{
		name: 'Canvas MCP',
		summary: 'A prototype MCP server that gives agents a scoped, governed way to work in Canvas, the learning management system.',
		points: [
			"The full Canvas API is too broad to hand to everyone's agent, but agents are genuinely useful for course and content management.",
			'I tried several designs and settled on 49 tools scoped to that work. Student data stays out entirely, nothing can be deleted, and only allowlisted courses are reachable.',
			'It was built to release to instructional designers and trusted faculty, with logging so we can see how people use it. It became the working demo in governance discussions.',
		],
	},
	{
		name: 'Skill Shelf',
		summary: 'An internal skill library for a team, used the same way people already use Google Drive.',
		points: [
			"It works for people who aren't on GitHub or don't feel comfortable there.",
			'It handles versions and updates, with search, readable skill pages and one-click installs.',
			'Having a shared library close at hand encourages people to use skills and share them with teammates.',
		],
		link: { href: 'https://github.com/jlmcmich/skill-shelf', label: 'Skill Shelf on GitHub' },
	},
	{
		name: 'Water Cooler',
		status: 'In development',
		summary: 'A shared space where people and agents work together.',
		points: [
			"It started with a small frustration. In the middle of agentic work I'd need a teammate's help, so I'd go ask them, then carry the answer back to my agent. A space we share would be easier.",
			'In meetings, we wanted one agent we could all talk with, and send off to do work on our behalf.',
			"Agent sessions run on a durable harness that also connects each person's own Claude Code or Codex. Next is a more proactive agent, and the team needed a space to get comfortable with agents in the conversation before calibrating that.",
		],
	},
	{
		name: 'The agentic LMS sandbox',
		summary: 'An immersive simulation of a familiar environment, a learning management system, where every student, instructor and administrator has an agent.',
		points: [
			'Groups set each agent tool to Allow, Ask or Block and feel the effect right away. A shared ledger shows what every agent did, and on whose behalf.',
			'The agents are scaffolded and limited on purpose, and the workbook carries the scenarios people play through.',
			'Because agents are so capable, we can build simulations deep enough to explore. People figure things out for themselves while I guide the experience, and they explore an idea together.',
		],
		video: { dir: 'sandbox', name: 'ledger', width: 1280, height: 1682, label: "Screen recording of the sandbox ledger filling with actions taken by the instructor's agent." },
		link: { href: '/sandbox', label: 'How the sandbox works' },
	},
];

const AI_PRACTICE_VIDEOS = 'https://script.google.com/macros/s/AKfycbxIVmUKw0hd2w-hl3MPNrElHdVW3euQvUUF0tCAlxikG-UyffBCoxG54adB82SqOc13OQ/exec';

const isExternal = (href: string) => href.startsWith('http');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Recent work | ${SITE_TITLE}`}
			description="Recent AI work at Arizona State University: how I approach AI strategy, hands-on Claude workshops, a new way to teach with agents, and the tools our team built."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-head" data-reveal>
				<h1>Recent work</h1>
				<p class="page-lede">
					Since July 2026 I've been an AI Strategist on Enterprise Technology's AI Practice, helping
					colleges and units across ASU put AI to work. Here is some of what that has looked like.
				</p>
			</section>

			<section class="section">
				<header class="section-head">
					<h2>How I approach AI strategy</h2>
				</header>
				<ol class="steps">
					{approach.map((s) => (
						<li class="step">
							<span class="step-n">{s.n}</span>
							<div class="step-body">
								<h3>{s.title}</h3>
								{s.body.map((p) => <p>{p}</p>)}
								{s.quote && (
									<blockquote>
										<p>“{s.quote.text}”</p>
										<cite>{s.quote.cite}</cite>
									</blockquote>
								)}
							</div>
						</li>
					))}
				</ol>
			</section>

			<section class="section">
				<header class="section-head">
					<h2>Engagements</h2>
				</header>
				<ul class="offer-list">
					{engagements.map((e) => (
						<li class="offer">
							<div class="offer-kind">{e.kind}</div>
							<div class="offer-body">
								<h3>{e.title}</h3>
								<p>{e.body}</p>
								{(e.links ?? (e.link ? [e.link] : [])).map((l) => (
									<a
										href={isExternal(l.href) ? l.href : url(l.href)}
										class="offer-link"
										{...(isExternal(l.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
									>
										{l.label} →
									</a>
								))}
							</div>
						</li>
					))}
				</ul>
			</section>

			<section class="section">
				<header class="section-head">
					<h2>A new way to teach with agents</h2>
				</header>
				<div class="prose">
					<p>
						Agents are hard to teach with. There are several screens at once, and an agent can go
						anywhere, so a newcomer doesn't know where to look. My workshops are built on a workbook that
						gives me a few simple pieces to work with. People work together, with agents and in the
						presence of agents, and share the same experience.
					</p>
				</div>
				<ul class="primitive-grid">
					{primitives.map((p) => (
						<li class="primitive">
							<h3>{p.name}</h3>
							<p>{p.body}</p>
						</li>
					))}
				</ul>
				<div class="prose">
					<p>
						Together they let me scaffold the experience and manage cognitive load, so people pay
						attention to the right thing at the right time. Most people need to feel comfortable with
						agents before they change how they work. This gets them there.
					</p>
				</div>
			</section>

			<section class="section" id="tools">
				<header class="section-head">
					<h2>Tools</h2>
				</header>
				<p class="section-intro">
					Our AI Practice team is new. We needed tools of our own, and building them with agents was
					also our research into what agents can do today. Each one started with a problem the team
					had, and is built for the team to use.
				</p>
				<a href={AI_PRACTICE_VIDEOS} class="videos-link" target="_blank" rel="noopener noreferrer">Watch short videos of the team's tools →</a>
				<div class="tool-list">
					{tools.map((t) => (
						<article class="tool">
							<div class="tool-media">
								{t.video ? (
									<LoopVideo dir={t.video.dir} name={t.video.name} width={t.video.width} height={t.video.height} label={t.video.label} />
								) : (
									<div class="trailer-slot" aria-hidden="true">
										<span>Trailer coming soon</span>
									</div>
								)}
							</div>
							<div class="tool-body">
								<div class="tool-head">
									<h3>{t.name}</h3>
									{t.status && <span class="status">{t.status}</span>}
								</div>
								<p class="tool-summary">{t.summary}</p>
								<ul class="tool-points">
									{t.points.map((p) => <li>{p}</li>)}
								</ul>
								{t.link && (
									<a
										href={isExternal(t.link.href) ? t.link.href : url(t.link.href)}
										class="offer-link"
										{...(isExternal(t.link.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
									>
										{t.link.label} →
									</a>
								)}
							</div>
						</article>
					))}
				</div>
			</section>

			<section class="section">
				<header class="section-head">
					<h2>Earlier AI work, 2023–2026</h2>
				</header>
				<ul class="offer-list">
					{earlierAi.map((p) => (
						<li class="offer">
							<div class="offer-kind">{p.data.year}</div>
							<div class="offer-body">
								<h3><a href={url(`/projects/${p.id}/`)} class="plain-link">{p.data.title}</a></h3>
								{p.data.role && <div class="earlier-meta">{p.data.role}{p.data.organization ? ` · ${p.data.organization}` : ''}</div>}
								<p>{p.data.description}</p>
							</div>
						</li>
					))}
				</ul>
			</section>

			<section class="cta-panel">
				<h2>Want a closer look?</h2>
				<p>
					Several of these tools run inside ASU and aren't public. I'm glad to walk through any of them.
				</p>
				<div class="head-cta">
					{CONTACT_EMAIL && <a href={`mailto:${CONTACT_EMAIL}`} class="btn">Email me</a>}
					<a href={url('/workshops#contact')} class="btn btn-outline">Contact form</a>
				</div>
			</section>
		</main>
		<Footer />

		<style>
			.page-head {
				padding: 2.5rem 0 3rem;
				border-bottom: 1px solid var(--color-border);
				margin-bottom: 3rem;
			}
			.page-head h1 { margin: 0 0 1rem; }
			.page-lede {
				font-size: 1.2rem;
				line-height: 1.6;
				color: var(--color-text-muted);
				max-width: 60ch;
				margin: 0;
			}
			.head-cta { display: flex; gap: 0.75rem; flex-wrap: wrap; }

			.section { margin-bottom: 4.5rem; }
			.section-head {
				margin-bottom: 1.5rem;
				padding-bottom: 0.75rem;
				border-bottom: 1px solid var(--color-border);
			}
			.section-head h2 {
				margin: 0;
				font-size: 1.45rem;
				font-weight: 600;
				letter-spacing: -0.018em;
			}
			.section-intro { color: var(--color-text-muted); max-width: 65ch; margin: 0 0 0.75rem; line-height: 1.65; }
			.videos-link {
				display: inline-block;
				margin-bottom: 2rem;
				font-family: var(--font-mono);
				font-size: 0.8rem;
				font-weight: 500;
			}

			.steps { list-style: none; padding: 0; margin: 0; }
			.step {
				display: grid;
				grid-template-columns: 2rem 1fr;
				padding: 1.5rem 0;
				border-bottom: 1px solid var(--color-border);
			}
			.step:first-child { padding-top: 0.25rem; }
			.step-n {
				font-family: var(--font-mono);
				font-size: 0.85rem;
				color: var(--color-accent);
				padding-top: 0.2rem;
			}
			.step-body { max-width: 65ch; }
			.step h3 { margin: 0 0 0.5rem; font-size: 1.2rem; }
			.step p { margin: 0 0 0.75rem; color: var(--color-text-muted); line-height: 1.65; }
			.step blockquote {
				margin: 1rem 0 0.25rem;
				padding-left: 1rem;
				border-left: 2px solid var(--color-accent);
			}
			.step blockquote p { margin: 0 0 0.3rem; color: var(--color-text-main); font-style: italic; }
			.step blockquote cite {
				font-family: var(--font-mono);
				font-size: 0.75rem;
				font-style: normal;
				color: var(--color-text-faint);
			}

			.offer-list { list-style: none; padding: 0; margin: 0; }
			.offer {
				display: grid;
				grid-template-columns: 170px 1fr;
				gap: 2rem;
				padding: 1.5rem 0;
				border-bottom: 1px solid var(--color-border);
			}
			.offer-kind {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				color: var(--color-text-faint);
				font-weight: 500;
				padding-top: 0.25rem;
			}
			.offer-body h3 { margin: 0 0 0.4rem; font-size: 1.2rem; }
			.plain-link { color: inherit; }
			.plain-link:hover { color: var(--color-accent); }
			.earlier-meta { font-size: 0.88rem; color: var(--color-text-faint); margin-bottom: 0.4rem; }
			.offer-body p {
				margin: 0;
				color: var(--color-text-muted);
				max-width: 65ch;
				line-height: 1.65;
			}
			.offer-link {
				display: inline-block;
				margin-top: 0.6rem;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				font-weight: 500;
				color: var(--color-text-muted);
			}
			.offer-link:hover { color: var(--color-accent); }
			.offer-link + .offer-link { margin-left: 1.25rem; }

			.prose { max-width: 65ch; }
			.prose p { color: var(--color-text-muted); line-height: 1.7; }

			.primitive-grid {
				list-style: none;
				padding: 0;
				margin: 1.25rem 0 1.5rem;
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1rem;
			}
			.primitive {
				border: 1px solid var(--color-border);
				border-radius: var(--radius);
				padding: 1.1rem 1.2rem;
				background: var(--color-bg-subtle);
			}
			.primitive h3 { margin: 0 0 0.4rem; font-size: 1rem; }
			.primitive p { margin: 0; font-size: 0.92rem; color: var(--color-text-muted); line-height: 1.6; }

			.tool-list { display: grid; gap: 2.5rem; }
			.tool {
				display: grid;
				grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
				gap: 2rem;
				padding-bottom: 2.5rem;
				border-bottom: 1px solid var(--color-border);
			}
			.tool-media :global(.loop-video) {
				border: 1px solid var(--color-border);
				border-radius: var(--radius);
				max-height: 360px;
				object-fit: cover;
				object-position: top;
			}
			.trailer-slot {
				aspect-ratio: 16 / 10;
				display: flex;
				align-items: center;
				justify-content: center;
				border: 1px dashed var(--color-border);
				border-radius: var(--radius);
				background: var(--color-bg-subtle);
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--color-text-faint);
			}
			.tool-head { display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; }
			.tool-head h3 { margin: 0; font-size: 1.2rem; }
			.status {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--color-text-faint);
			}
			.tool-summary { margin: 0.5rem 0 0.75rem; color: var(--color-text-main); line-height: 1.6; }
			.tool-points { margin: 0 0 0.75rem; padding-left: 1.1rem; color: var(--color-text-muted); }
			.tool-points li { margin-bottom: 0.4rem; line-height: 1.6; }

			.cta-panel {
				border: 1px solid var(--color-border);
				border-radius: var(--radius);
				padding: 2.25rem 2rem;
				background: var(--color-bg-subtle);
			}
			.cta-panel h2 { margin: 0 0 0.6rem; font-size: 1.6rem; }
			.cta-panel p { color: var(--color-text-muted); max-width: 58ch; margin-bottom: 1.5rem; }

			@media (max-width: 860px) {
				.tool { grid-template-columns: 1fr; gap: 1rem; }
			}
			@media (max-width: 640px) {
				.offer { grid-template-columns: 1fr; gap: 0.4rem; }
				.primitive-grid { grid-template-columns: 1fr; }
				.cta-panel { padding: 1.75rem 1.25rem; }
			}
		</style>
	</body>
</html>
