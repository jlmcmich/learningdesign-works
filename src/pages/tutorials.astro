---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import { url } from '../utils/paths';

const tutorials = (await getCollection('tutorials'))
	.filter((entry) => entry.data.showOnIndex)
	.sort((a, b) => {
		const orderA = a.data.order ?? 999;
		const orderB = b.data.order ?? 999;
		if (orderA !== orderB) return orderA - orderB;
		return a.data.title.localeCompare(b.data.title);
	});

const categories = [
	'Getting Started',
	'Under the Hood',
	'Working with Agents',
	'Workflow Patterns',
	'Deep Dives',
] as const;

const grouped = categories
	.map((category) => ({
		category,
		items: tutorials.filter((entry) => entry.data.category === category),
	}))
	.filter((group) => group.items.length > 0);

const featured = tutorials[0];
const topicId = (label: string) =>
	label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Tutorials | ${SITE_TITLE}`}
			description="A growing library of videos, notes, and examples for people learning how to work with agentic AI tools."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-head" data-reveal>
				<h1>Agentic AI Tutorials</h1>
				<p class="page-lede">
					A growing collection of videos, notes, and examples for people learning how to work with agentic AI tools.
				</p>
			</section>

			<nav class="filter-row" aria-label="Tutorial topics" data-reveal style="--reveal-delay: 60ms;">
				{grouped.map((group) => (
					<a href={`#${topicId(group.category)}`} class="filter-pill">
						{group.category}
					</a>
				))}
			</nav>

			{featured && (
				<section class="featured" data-reveal style="--reveal-delay: 120ms;">
					<div class="featured-media">
						{featured.data.videoUrl ? (
							<div class="video-embed">
								<iframe
									src={featured.data.videoUrl}
									title={featured.data.title}
									loading="lazy"
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
									allowfullscreen
								></iframe>
							</div>
						) : (
							<a class="video-placeholder" href={url(`/tutorials/${featured.id}/`)}>
								<span class="placeholder-kicker">{featured.data.status}</span>
								<div class="placeholder-main">
									<span class="play-mark" aria-hidden="true">▶</span>
									<span>Video placeholder</span>
								</div>
							</a>
						)}
					</div>
					<div class="featured-copy">
						<div class="meta-line">
							<span>{featured.data.category}</span>
							{featured.data.duration && (
								<>
									<span class="dot">·</span>
									<span>{featured.data.duration}</span>
								</>
							)}
						</div>
						<h2>
							<a href={url(`/tutorials/${featured.id}/`)}>{featured.data.title}</a>
						</h2>
						<p>{featured.data.description}</p>
						{featured.data.learn && (
							<ul class="learn-list">
								{featured.data.learn.slice(0, 3).map((item) => <li>{item}</li>)}
							</ul>
						)}
					</div>
				</section>
			)}

			{grouped.map((group) => (
				<section class="topic-section" id={topicId(group.category)}>
					<header class="section-head">
						<h2>{group.category}</h2>
					</header>

					<ul class="entry-list">
						{group.items.map((item) => (
							<li class="entry">
								<a class="entry-link" href={url(`/tutorials/${item.id}/`)}>
									<div class="entry-meta-col">
										<div class="entry-status">{item.data.status}</div>
										{item.data.duration && <div class="entry-duration">{item.data.duration}</div>}
									</div>
									<div class="entry-body">
										<h3 class="entry-title">{item.data.title}</h3>
										<p class="entry-desc">{item.data.description}</p>
									</div>
									<div class="entry-arrow" aria-hidden="true">→</div>
								</a>
							</li>
						))}
					</ul>
				</section>
			))}
		</main>
		<Footer />

		<style>
			.page-head {
				padding: 2.5rem 0 2.25rem;
				border-bottom: 1px solid var(--color-border);
				margin-bottom: 1.5rem;
				max-width: 68ch;
			}
			.page-head h1 {
				margin: 0 0 0.9rem;
			}
			.page-lede {
				font-size: 1.08rem;
				line-height: 1.65;
				color: var(--color-text-muted);
				margin: 0;
			}

			.filter-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.65rem;
				margin-bottom: 2.5rem;
			}
			.filter-pill {
				border: 1px solid var(--color-border);
				border-radius: 999px;
				padding: 0.45rem 0.75rem;
				font-size: 0.82rem;
				color: var(--color-text-muted);
				background: var(--color-bg);
			}
			.filter-pill:hover {
				color: var(--color-text-main);
				border-bottom-color: var(--color-border);
				border-color: var(--color-text-main);
			}

			.featured {
				display: grid;
				grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
				gap: 2rem;
				align-items: start;
				padding-bottom: 2.5rem;
				margin-bottom: 3rem;
				border-bottom: 1px solid var(--color-border);
			}
			.video-embed {
				aspect-ratio: 16 / 9;
				border: 1px solid var(--color-border);
				border-radius: 16px;
				overflow: hidden;
				background: linear-gradient(180deg, var(--color-bg-subtle), var(--color-bg));
			}
			.video-embed iframe {
				width: 100%;
				height: 100%;
				border: 0;
			}
			.video-placeholder {
				display: block;
				aspect-ratio: 16 / 9;
				border: 1px solid var(--color-border);
				border-radius: 16px;
				background:
					linear-gradient(180deg, var(--color-bg-subtle), var(--color-bg));
				padding: 1.1rem;
				color: inherit;
			}
			.video-placeholder:hover {
				border-color: var(--color-text-main);
				border-bottom-color: var(--color-text-main);
			}
			.placeholder-kicker {
				display: inline-block;
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--color-text-faint);
			}
			.placeholder-main {
				height: calc(100% - 1.5rem);
				display: grid;
				place-items: center;
				gap: 0.5rem;
				color: var(--color-text-muted);
				font-size: 0.95rem;
			}
			.play-mark {
				font-size: 1.6rem;
				color: var(--color-accent);
			}
			.featured-copy {
				max-width: 48ch;
			}
			.meta-line {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				font-family: var(--font-mono);
				font-size: 0.78rem;
				color: var(--color-text-faint);
				margin-bottom: 1rem;
			}
			.dot {
				color: var(--color-text-faint);
			}
			.featured-copy h2 {
				margin: 0 0 0.85rem;
				font-size: clamp(1.6rem, 2.5vw, 2.1rem);
			}
			.featured-copy h2 a {
				border: none;
			}
			.featured-copy p {
				margin: 0 0 1rem;
				color: var(--color-text-muted);
				font-size: 1rem;
				line-height: 1.65;
			}
			.learn-list {
				margin: 0;
				padding-left: 1.2rem;
				color: var(--color-text-main);
			}
			.learn-list li {
				margin-bottom: 0.45rem;
			}

			.topic-section {
				margin-bottom: 3rem;
				scroll-margin-top: 5rem;
			}
			.section-head {
				margin-bottom: 1rem;
				padding-bottom: 0.75rem;
				border-bottom: 1px solid var(--color-border);
			}
			.section-head h2 {
				margin: 0;
				font-size: 1.2rem;
			}

			.entry-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.entry {
				border-bottom: 1px solid var(--color-border);
			}
			.entry-link {
				display: grid;
				grid-template-columns: 120px 1fr auto;
				gap: 1.75rem;
				padding: 1.2rem 0;
				color: inherit;
				border: none;
				transition: padding 0.2s var(--ease);
			}
			.entry-link:hover {
				padding-left: 0.5rem;
			}
			.entry-link:hover .entry-title {
				color: var(--color-accent);
			}
			.entry-link:hover .entry-arrow {
				color: var(--color-accent);
				transform: translateX(4px);
			}
			.entry-meta-col {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--color-text-faint);
				padding-top: 0.2rem;
			}
			.entry-status {
				margin-bottom: 0.35rem;
			}
			.entry-title {
				font-size: 1.08rem;
				font-weight: 600;
				margin: 0 0 0.35rem;
				color: var(--color-text-main);
				transition: color 0.15s var(--ease);
			}
			.entry-desc {
				margin: 0;
				font-size: 0.96rem;
				line-height: 1.55;
				color: var(--color-text-muted);
				max-width: 64ch;
			}
			.entry-arrow {
				color: var(--color-text-faint);
				padding-top: 0.25rem;
				transition: transform 0.2s var(--ease), color 0.15s var(--ease);
			}

			@media (max-width: 800px) {
				.featured {
					grid-template-columns: 1fr;
				}
				.entry-link {
					grid-template-columns: 1fr;
					gap: 0.8rem;
				}
				.entry-arrow {
					display: none;
				}
			}
		</style>
	</body>
</html>
