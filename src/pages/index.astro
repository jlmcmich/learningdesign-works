---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import { url } from '../utils/paths';
import LoopVideo from '../components/LoopVideo.astro';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featuredProjects = projects.slice(0, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} — ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero" data-reveal>
				<div class="hero-grid">
					<div class="hero-text">
						<h1 class="hero-name">Jonathan McMichael</h1>
						<p class="hero-title">AI Strategist</p>
						<p class="hero-role">
							Enterprise Technology, Arizona State University.
						</p>
						<p class="hero-lede">
							AI may be reshaping how higher education works, but not what it's for. Currently, my job is to develop ways that <strong>artificial intelligence</strong> supports our educational mission: built on what we know about how people grow, and anchored in the aspirations of a <strong>comprehensive public university</strong>.
						</p>
						<div class="hero-cta">
							<a href={url('/workshops#contact')} class="btn">Bring this to your campus</a>
							<a href={url('/sandbox')} class="btn btn-outline">See the sandbox</a>
						</div>
					</div>

					<div class="hero-portrait">
						<img src={url('/jonathan.png')} alt="Jonathan McMichael" loading="eager" />
					</div>
				</div>
			</section>

			<section class="section sandbox-band">
				<header class="section-head">
					<h2>The agentic LMS sandbox</h2>
					<a href={url('/sandbox')} class="section-cta">How it works →</a>
				</header>

				<p class="band-lede">
					A space where higher education professionals can come together to experiment and make sense of what agents might mean for how we teach, learn, and work.
				</p>
				<div class="band-grid">
					<div class="band-text">
						<ul class="band-points">
							<li><strong>Explore agents in a shared environment.</strong> Informed responses to agents should come from how we work together. People get a shared experience of where AI and the practices of higher education on our campuses might meet, and a place to talk about what it means.</li>
							<li><strong>A safe space to experiment.</strong> Putting agents into a real LMS is daunting. Everything in the sandbox is made up, so no sensitive data is exposed.</li>
							<li><strong>Adaptive and immersive.</strong> Student, instructor and administrator characters with agents act on the same simulated courses, so you see agents from many perspectives at once. It's a deeply immersive thought experiment, and it can adapt as the technology changes.</li>
							<li><strong>It travels.</strong> I can bring it to your campus as a workshop, or help your people learn to run it.</li>
						</ul>
					</div>
					<div class="band-side">
						<figure class="band-figure">
							<a href={url('/sandbox')} class="band-shot" aria-label="See the agentic LMS sandbox">
								<LoopVideo name="hero-agent-run" width={1600} height={812} label="Screen recording. A student asks their agent for help catching up in ENG 101, and the agent works through a fictional course site in its own browser, then drafts a message to the instructor." />
							</a>
							<figcaption>A student's agent catching them up in ENG 101, working in the fictional LMS through its own browser. Sped up. All data is fictional.</figcaption>
						</figure>
						<p class="band-origin">
							Built for "Designing Learning Environments in an Agentic World," a workshop with Michelle Kassorla at the AAC&amp;U Conference on AI and Higher Education.
						</p>
						<div class="hero-cta">
							<a href={url('/sandbox')} class="btn">See the sandbox</a>
							<a href={url('/workshops')} class="btn btn-outline">Workshops and talks</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section">
				<header class="section-head">
					<h2>What I'm working on</h2>
					<p class="section-sub">My current focus at ASU and beyond.</p>
				</header>

				<div class="now-grid">
					<div class="now-block">
						<div class="now-label">Role</div>
						<p>
							<strong>AI Strategist</strong>, Enterprise Technology, Arizona State University.
							Helping colleges and units across the university put AI to work through strategy consultations, workshops, and hands-on prototypes.
						</p>
					</div>
					<div class="now-block">
						<div class="now-label">National Leadership</div>
						<p>
							<strong>Faculty Mentor</strong>, <a href="https://www.aacu.org/event/2025-26-institute-ai-pedagogy-curriculum">AAC&amp;U Institute on AI, Pedagogy, and Curriculum</a>.
							Focused on the practical and ethical integration of <strong>agentic AI</strong> in higher education.
						</p>
					</div>
					<div class="now-block">
						<div class="now-label">Selected Projects</div>
						<ul class="now-list">
							<li><a href={url('/sandbox')}><strong>Agentic LMS sandbox</strong></a>: A simulated course site where student, instructor and admin agents meet. Built for a workshop with Michelle Kassorla.</li>
							<li><a href={url('/tutorials')}><strong>Agentic AI Tutorials</strong></a>: A growing video series for people learning to work with agentic AI tools.</li>
							<li><a href={url('/projects/vibecheck/')}><strong>VibeCheck</strong></a>: Student learning-reflection app with AI-powered insights.</li>
							<li><a href="https://ai.asu.edu/ai-tools/learning-design-suite"><strong>Learning Design Suite</strong></a>: Contributed 4 tools for learning objectives, module design, assignment language, and discussion prompts.</li>
						</ul>
					</div>
				</div>
			</section>

			<section class="section">
				<header class="section-head">
					<h2>Recent work</h2>
					<a href={url('/projects')} class="section-cta">All projects →</a>
				</header>

				<ul class="entry-list">
					{featuredProjects.map((p) => (
						<li class="entry">
							<a class="entry-link" href={url(`/projects/${p.id}/`)}>
								<div class="entry-year">{p.data.year}</div>
								<div class="entry-body">
									<h3 class="entry-title">{p.data.title}</h3>
									{(p.data.role || p.data.organization) && (
										<div class="entry-meta">
											{p.data.role}{p.data.role && p.data.organization ? ' · ' : ''}{p.data.organization}
										</div>
									)}
									<p class="entry-desc">{p.data.description}</p>
								</div>
								<div class="entry-arrow" aria-hidden="true">→</div>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />

		<style>
			.hero {
				padding: 3rem 0 4rem;
				border-bottom: 1px solid var(--color-border);
				margin-bottom: 4rem;
			}
			.hero-grid {
				display: grid;
				grid-template-columns: 1.6fr 1fr;
				gap: 4rem;
				align-items: center;
			}
			.hero-name {
				margin: 0 0 0.5rem;
				font-size: clamp(2.5rem, 6vw, 4.25rem);
				font-weight: 700;
				letter-spacing: -0.035em;
				line-height: 1.05;
			}
			.hero-title {
				font-size: 1.4rem;
				font-weight: 600;
				color: var(--color-text-main);
				letter-spacing: -0.014em;
				line-height: 1.3;
				margin: 0 0 0.65rem;
			}
			.hero-role {
				font-size: 1.1rem;
				color: var(--color-text-muted);
				margin: 0 0 1.75rem;
				max-width: 50ch;
				line-height: 1.5;
			}
			.hero-lede {
				font-size: 1.1rem;
				line-height: 1.65;
				max-width: 56ch;
				color: var(--color-text-muted);
				margin-bottom: 2rem;
			}
			.hero-lede strong {
				color: var(--color-text-main);
				font-weight: 600;
			}
			.hero-cta {
				display: flex;
				gap: 0.75rem;
				flex-wrap: wrap;
			}

			.hero-portrait {
				justify-self: end;
				width: 100%;
				max-width: 320px;
			}
			.hero-portrait img {
				display: block;
				width: 100%;
				aspect-ratio: 1 / 1;
				object-fit: cover;
				border-radius: 50%;
			}
			[data-theme='dark'] .hero-portrait img { filter: brightness(0.95); }

			/* ===== SECTIONS ===== */
			.section {
				margin-bottom: 5rem;
			}
			.section-head {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1rem;
				margin-bottom: 2rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid var(--color-border);
			}
			.section-head h2 {
				margin: 0;
			}
			.section-sub {
				margin: 0;
				color: var(--color-text-muted);
				font-size: 0.95rem;
			}
			.section-cta {
				font-size: 0.88rem;
				font-weight: 500;
				color: var(--color-text-muted);
				border: none;
				white-space: nowrap;
			}
			.section-cta:hover { color: var(--color-accent); border: none; }

			/* ===== SANDBOX BAND ===== */
			.band-grid {
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
				gap: 3rem;
				align-items: start;
			}
			.band-lede {
				font-size: 1.25rem;
				line-height: 1.55;
				margin: 0 0 2rem;
			}
			.band-points {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.band-points li {
				font-size: 0.96rem;
				line-height: 1.6;
				color: var(--color-text-muted);
				margin-bottom: 0.85rem;
			}
			.band-origin {
				font-size: 0.88rem;
				color: var(--color-text-faint);
				margin: 1.5rem 0 1.25rem;
			}
			.band-figure { margin: 0; }
			.band-shot {
				display: block;
				border: 1px solid var(--color-border);
				border-radius: var(--radius);
				overflow: hidden;
				box-shadow: var(--shadow-md);
			}
			.band-shot:hover { border-color: var(--color-accent); }
			.band-shot :global(img), .band-shot :global(video) { display: block; width: 100%; height: auto; }
			.band-figure figcaption {
				margin-top: 0.6rem;
				font-size: 0.82rem;
				color: var(--color-text-faint);
			}

			/* ===== NOW GRID ===== */
			.now-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 2.5rem;
			}
			.now-label {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--color-text-faint);
				font-weight: 500;
				margin-bottom: 0.75rem;
			}
			.now-block p {
				margin: 0;
				font-size: 0.96rem;
				line-height: 1.6;
				color: var(--color-text-muted);
			}
			.now-block strong {
				color: var(--color-text-main);
				font-weight: 600;
			}
			.now-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.now-list li {
				font-size: 0.92rem;
				line-height: 1.5;
				margin-bottom: 0.6rem;
				color: var(--color-text-muted);
				padding-left: 1rem;
				position: relative;
			}
			.now-list li::before {
				content: "";
				position: absolute;
				left: 0;
				top: 0.7em;
				width: 6px;
				height: 1px;
				background: var(--color-text-faint);
			}

			/* ===== ENTRY LIST (recent work) ===== */
			.entry-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.entry { border-bottom: 1px solid var(--color-border); }
			.entry-link {
				display: grid;
				grid-template-columns: 70px 1fr auto;
				gap: 2rem;
				padding: 1.5rem 0;
				color: inherit;
				border: none;
				transition: padding 0.2s var(--ease);
			}
			.entry-link:hover {
				padding-left: 0.5rem;
				border: none;
			}
			.entry-link:hover .entry-title { color: var(--color-accent); }
			.entry-link:hover .entry-arrow {
				color: var(--color-accent);
				transform: translateX(4px);
			}
			.entry-year {
				font-family: var(--font-mono);
				font-size: 0.85rem;
				color: var(--color-text-faint);
				font-weight: 500;
				padding-top: 0.3rem;
			}
			.entry-title {
				font-size: 1.2rem;
				font-weight: 600;
				margin: 0 0 0.3rem;
				color: var(--color-text-main);
				line-height: 1.3;
				transition: color 0.15s var(--ease);
			}
			.entry-meta {
				font-size: 0.85rem;
				color: var(--color-text-faint);
				margin-bottom: 0.5rem;
			}
			.entry-desc {
				margin: 0;
				font-size: 0.96rem;
				line-height: 1.55;
				color: var(--color-text-muted);
				max-width: 60ch;
			}
			.entry-arrow {
				font-size: 1.1rem;
				color: var(--color-text-faint);
				padding-top: 0.4rem;
				transition: transform 0.2s var(--ease), color 0.15s var(--ease);
			}

			@media (max-width: 880px) {
				.hero-grid {
					grid-template-columns: 1fr;
					gap: 2.5rem;
				}
				.hero-portrait {
					justify-self: start;
					max-width: 200px;
				}
				.band-grid {
					grid-template-columns: 1fr;
					gap: 2rem;
				}
				.band-side { order: -1; }
				.now-grid {
					grid-template-columns: 1fr;
					gap: 2rem;
				}
				.entry-link {
					grid-template-columns: 60px 1fr;
				}
				.entry-arrow { display: none; }
			}
		</style>
	</body>
</html>
