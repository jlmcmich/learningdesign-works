---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import { url } from '../utils/paths';

const projects = (await getCollection('projects'))
	.filter((p) => p.data.year < 2023)
	.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const teaching = [
	{
		years: '2016–2023',
		title: 'First-Year Writing Information Literacy Program',
		org: 'Southern Methodist University',
		description: 'Designed the information literacy curriculum and ran the program that delivered it to every section of First-Year Writing, including research-assignment design and training every instructor in the program.',
	},
	{
		years: '2013–2016',
		title: 'Master’s theses advised',
		org: 'UNC School of Information and Library Science',
		description: 'Advised eight master’s theses in instructional design and information literacy. Several became peer-reviewed publications and national conference presentations, and one won the Dean’s Achievement Award.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Earlier work | ${SITE_TITLE}`}
			description="Thirteen years as an academic librarian and instructional designer: teaching information literacy, designing institutes and courses, and mentoring new librarians."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-head" data-reveal>
				<h1>Earlier work</h1>
				<p class="page-lede">
					Before AI, I spent thirteen years as an academic librarian and instructional designer. I taught
					information literacy to undergraduates for a decade: how information is made, organized and
					judged. I designed institutes and courses that taught people new technical practices together,
					and built programs that helped new librarians grow into the field.
				</p>
			</section>

			<ul class="entry-list">
				{projects.map((p) => (
					<li class="entry">
						<a class="entry-link" href={url(`/projects/${p.id}/`)}>
							<div class="entry-year">{p.data.year}</div>
							<div class="entry-body">
								<h2 class="entry-title">{p.data.title}</h2>
								{(p.data.role || p.data.organization) && (
									<div class="entry-meta">
										{p.data.role}{p.data.role && p.data.organization ? ' · ' : ''}{p.data.organization}
									</div>
								)}
								<p class="entry-desc">{p.data.description}</p>
								{p.data.tags && p.data.tags.length > 0 && (
									<div class="entry-tags">
										{p.data.tags.map((tag) => <span class="tag">{tag}</span>)}
									</div>
								)}
							</div>
							<div class="entry-arrow" aria-hidden="true">→</div>
						</a>
					</li>
				))}
			</ul>

			<section class="section">
				<header class="section-head">
					<h2>Teaching and mentorship</h2>
				</header>
				<ul class="teach-list">
					{teaching.map((t) => (
						<li class="teach">
							<div class="entry-year">{t.years}</div>
							<div>
								<h3>{t.title}</h3>
								<div class="entry-meta">{t.org}</div>
								<p class="entry-desc">{t.description}</p>
							</div>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />

		<style>
			.page-head {
				padding: 2.5rem 0 3rem;
				border-bottom: 1px solid var(--color-border);
				margin-bottom: 2rem;
			}
			.page-head h1 {
				margin: 0 0 1rem;
			}
			.page-lede {
				font-size: 1.1rem;
				line-height: 1.65;
				color: var(--color-text-muted);
				max-width: 65ch;
				margin: 0 0 1.5rem;
			}
			.page-meta {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				color: var(--color-text-faint);
				font-weight: 500;
			}

			.entry-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.entry { border-bottom: 1px solid var(--color-border); }
			.entry-link {
				display: grid;
				grid-template-columns: 90px 1fr auto;
				gap: 2.5rem;
				padding: 1.75rem 0;
				color: inherit;
				border: none;
				transition: padding 0.2s var(--ease);
			}
			.entry-link:hover {
				padding-left: 0.75rem;
				border: none;
			}
			.entry-link:hover .entry-title { color: var(--color-accent); }
			.entry-link:hover .entry-arrow {
				color: var(--color-accent);
				transform: translateX(4px);
			}
			.entry-year {
				font-family: var(--font-mono);
				font-size: 0.9rem;
				color: var(--color-text-faint);
				font-weight: 500;
				padding-top: 0.3rem;
			}
			.entry-title {
				font-size: 1.4rem;
				font-weight: 600;
				margin: 0 0 0.35rem;
				line-height: 1.25;
				color: var(--color-text-main);
				letter-spacing: -0.015em;
				transition: color 0.15s var(--ease);
			}
			.entry-meta {
				font-size: 0.88rem;
				color: var(--color-text-faint);
				margin-bottom: 0.65rem;
			}
			.entry-desc {
				margin: 0 0 0.85rem;
				font-size: 0.98rem;
				line-height: 1.55;
				color: var(--color-text-muted);
				max-width: 62ch;
			}
			.entry-tags {
				display: flex;
				gap: 0.4rem;
				flex-wrap: wrap;
			}
			.tag {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				color: var(--color-text-faint);
				padding: 0.2rem 0.55rem;
				border: 1px solid var(--color-border);
				border-radius: var(--radius-sm);
				font-weight: 500;
			}
			.entry-arrow {
				font-size: 1.1rem;
				color: var(--color-text-faint);
				padding-top: 0.4rem;
				transition: transform 0.2s var(--ease), color 0.15s var(--ease);
			}

			.section { margin-top: 4rem; }
			.section-head {
				margin-bottom: 0.5rem;
				padding-bottom: 0.75rem;
				border-bottom: 1px solid var(--color-border);
			}
			.section-head h2 {
				margin: 0;
				font-size: 1.45rem;
				font-weight: 600;
				letter-spacing: -0.018em;
			}
			.teach-list { list-style: none; padding: 0; margin: 0; }
			.teach {
				display: grid;
				grid-template-columns: 90px 1fr;
				gap: 2.5rem;
				padding: 1.5rem 0;
				border-bottom: 1px solid var(--color-border);
			}
			.teach h3 { margin: 0 0 0.35rem; font-size: 1.15rem; }

			@media (max-width: 720px) {
				.teach { grid-template-columns: 60px 1fr; gap: 1.25rem; }
				.entry-link {
					grid-template-columns: 60px 1fr;
					gap: 1.25rem;
				}
				.entry-arrow { display: none; }
			}
		</style>
	</body>
</html>
