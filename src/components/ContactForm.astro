---
// Short contact form. Messages are saved and emailed to me (see functions/api/contact.js).
// Links with data-interest="<value>", or ?interest=<value> in the URL, tick that box.
const INTERESTS = [
	['walkthrough', 'A 30-minute walkthrough'],
	['workshop', 'A sandbox workshop'],
	['run-it-yourselves', 'Running it yourselves'],
	['talk', 'A talk'],
	['curious', 'Just curious'],
];
---

<form class="contact-form" action="/api/contact" method="post" data-contact-form>
	<input type="hidden" name="pageUrl" value={Astro.url.pathname} />

	<div class="field-grid">
		<label>
			<span>Name</span>
			<input type="text" name="name" autocomplete="name" required maxlength="200" />
		</label>

		<label>
			<span>Email</span>
			<input type="email" name="email" autocomplete="email" required maxlength="320" />
		</label>
	</div>

	<label>
		<span>Campus or organization (optional)</span>
		<input type="text" name="organization" autocomplete="organization" maxlength="200" />
	</label>

	<fieldset class="interests">
		<legend>What are you interested in? (optional)</legend>
		<div class="interest-options">
			{INTERESTS.map(([value, label]) => (
				<label class="interest">
					<input type="checkbox" name="interests" value={value} />
					<span>{label}</span>
				</label>
			))}
		</div>
	</fieldset>

	<label>
		<span>Message</span>
		<textarea name="message" rows="5" maxlength="4000"></textarea>
	</label>

	<label class="field-honeypot" aria-hidden="true">
		<span>Leave this blank</span>
		<input type="text" name="website" tabindex="-1" autocomplete="off" />
	</label>

	<div class="contact-actions">
		<button type="submit" class="btn">Send message</button>
		<p class="contact-status" data-contact-status aria-live="polite"></p>
	</div>
</form>

<script>
	const forms = document.querySelectorAll('[data-contact-form]');

	const tick = (value) => {
		for (const box of document.querySelectorAll(`[data-contact-form] input[name="interests"][value="${value}"]`)) {
			if (box instanceof HTMLInputElement) box.checked = true;
		}
	};

	const preset = new URLSearchParams(location.search).get('interest');
	if (preset) tick(preset);

	for (const link of document.querySelectorAll('[data-interest]')) {
		link.addEventListener('click', () => {
			if (link instanceof HTMLElement && link.dataset.interest) tick(link.dataset.interest);
		});
	}

	for (const form of forms) {
		const status = form.querySelector('[data-contact-status]');
		const button = form.querySelector('button[type="submit"]');

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (!(form instanceof HTMLFormElement) || !(button instanceof HTMLButtonElement)) return;

			button.disabled = true;
			if (status) status.textContent = 'Sending...';

			try {
				const response = await fetch(form.action, {
					method: 'POST',
					headers: {
						Accept: 'application/json',
					},
					body: new FormData(form),
				});

				const result = await response.json().catch(() => ({}));

				if (!response.ok) {
					throw new Error(result?.error || 'Unable to send your message right now.');
				}

				form.reset();
				if (status) status.textContent = "Thanks. Your message was sent, and I'll get back to you.";
			} catch (error) {
				if (status) {
					status.textContent =
						error instanceof Error ? error.message : 'Unable to send your message right now.';
				}
			} finally {
				button.disabled = false;
			}
		});
	}
</script>

<style>
	.contact-form {
		display: grid;
		gap: 1rem;
	}
	.field-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}
	.contact-form label {
		display: grid;
		gap: 0.45rem;
	}
	.contact-form span {
		font-size: 0.82rem;
		color: var(--color-text-muted);
	}
	.contact-form input,
	.contact-form select,
	.contact-form textarea {
		width: 100%;
		font: inherit;
		color: var(--color-text-main);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: 0.75rem 0.85rem;
	}
	.contact-form .interests {
		margin: 0;
		padding: 0;
		border: 0;
	}
	.contact-form legend {
		margin-bottom: 0.55rem;
		font-size: 0.82rem;
		color: var(--color-text-muted);
	}
	.interest-options {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.contact-form label.interest {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.45rem 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		cursor: pointer;
	}
	.contact-form label.interest:has(input:checked) {
		border-color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 8%, transparent);
	}
	.contact-form .interest input {
		width: auto;
		margin: 0;
		accent-color: var(--color-accent);
	}
	.contact-form .interest span {
		font-size: 0.88rem;
		color: var(--color-text-main);
	}
	.contact-form textarea {
		resize: vertical;
		min-height: 8rem;
	}
	.contact-form input:focus,
	.contact-form select:focus,
	.contact-form textarea:focus {
		outline: 2px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
		outline-offset: 1px;
		border-color: var(--color-accent);
	}
	.contact-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.9rem;
	}
	.contact-status {
		margin: 0;
		font-size: 0.88rem;
		color: var(--color-text-muted);
	}
	.field-honeypot {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}
	@media (max-width: 720px) {
		.field-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
